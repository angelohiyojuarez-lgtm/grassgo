    }
    function directId(id) {
      return id is string && id.matches('^[A-Za-z0-9-]{1,80}$');
    }
    function validPaymentSnapshot(p) {
      return p is map && p.keys().hasAll(['mode','qr','methods','recipient','phone'])
        && p.keys().hasOnly(['mode','qr','methods','recipient','phone'])
        && p.mode in ['demo','live']
        && p.qr is string && p.qr.size() <= 2000
        && p.methods is list && p.methods.size() >= 1 && p.methods.size() <= 2
        && p.methods.hasOnly(['Yape','Plin'])
        && p.recipient is string && p.recipient.size() <= 120
        && p.phone is string && p.phone.size() <= 20;
    }
    // Valida el documento completo en cada creación y actualización. No vuelve a
    // cotejar tarifas actuales al revisar: el precio contratado queda histórico.
    function validDirectRequest(d) {
      let localTime = d.startsAt - duration.value(5, 'h');
      let fields = d.keys();
      return fields.hasAll(['clientUid','establishmentId','establishmentName','courtId','courtName','date','hour','startsAt','endsAt','totalCents','advanceCents','createdAt','status','paymentStatus','paymentSnapshot'])
        && fields.hasOnly(['clientUid','establishmentId','establishmentName','courtId','courtName','date','hour','startsAt','endsAt','totalCents','advanceCents','createdAt','status','paymentStatus','paymentSnapshot','proofSubmittedAt','reviewedAt','reviewedBy','verifiedAdvanceCents','serviceStatus','actualStartAt','actualEndAt'])
        && d.clientUid is string && d.clientUid.size() >= 1 && d.clientUid.size() <= 128
        && directId(d.establishmentId) && directId(d.courtId)
        && d.establishmentName is string && d.establishmentName.size() >= 1 && d.establishmentName.size() <= 120
        && d.courtName is string && d.courtName.size() >= 1 && d.courtName.size() <= 120
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.startsAt is timestamp && d.endsAt is timestamp && d.createdAt is timestamp
        && d.hour is int && d.hour >= 0 && d.hour < 24
        && localTime.year() == int(d.date.split('-')[0]) && localTime.month() == int(d.date.split('-')[1]) && localTime.day() == int(d.date.split('-')[2])
        && localTime.hours() == d.hour && localTime.minutes() == 0 && localTime.seconds() == 0 && localTime.nanos() == 0
        && d.endsAt == d.startsAt + duration.value(1, 'h')
        && d.totalCents is int && d.totalCents >= 1000 && d.totalCents <= 100000000
        && d.advanceCents is int && d.advanceCents >= 1 && d.advanceCents <= d.totalCents && d.advanceCents <= 1000000
        && validPaymentSnapshot(d.paymentSnapshot)
        && (!fields.hasAny(['proofSubmittedAt']) || d.proofSubmittedAt is timestamp)
        && (!fields.hasAny(['reviewedAt']) || d.reviewedAt is timestamp)
        && (!fields.hasAny(['reviewedBy']) || (d.reviewedBy is string && d.reviewedBy.size() >= 1 && d.reviewedBy.size() <= 128))
        && (!fields.hasAny(['verifiedAdvanceCents']) || (d.verifiedAdvanceCents is int && d.verifiedAdvanceCents == d.advanceCents))
        && validDirectState(d)
        && (!fields.hasAny(['serviceStatus','actualStartAt','actualEndAt']) || validDirectService(d));
    }
    function validDirectService(d) {
      return !d.keys().hasAny(['serviceStatus','actualStartAt','actualEndAt'])
        || (d.status == 'confirmed' && d.paymentStatus == 'verified'
          && d.keys().hasAll(['serviceStatus','actualStartAt']) && d.actualStartAt is timestamp
          && d.actualStartAt >= d.startsAt
          && ((d.serviceStatus == 'running' && !d.keys().hasAny(['actualEndAt']))
            || (d.serviceStatus == 'completed' && d.actualEndAt is timestamp && d.actualEndAt == d.actualStartAt + duration.value(1, 'h'))));
    }
    function validDirectState(d) {
      let fields = d.keys();
      let proof = fields.hasAny(['proofSubmittedAt']);
      let reviewed = fields.hasAll(['reviewedAt','reviewedBy']);
      let verified = fields.hasAny(['verifiedAdvanceCents']);
      return (d.status == 'pending_payment' && d.paymentStatus == 'unpaid'
          && !proof && !fields.hasAny(['reviewedAt','reviewedBy','verifiedAdvanceCents']))
        || (d.status == 'pending_verification' && d.paymentStatus == 'submitted'
          && proof && !fields.hasAny(['reviewedAt','reviewedBy','verifiedAdvanceCents']))
        || (d.status == 'confirmed' && d.paymentStatus == 'verified' && proof && reviewed && verified)
        || (d.status == 'rejected' && d.paymentStatus == 'unpaid' && proof && reviewed && !verified);
    }
    function directConfigurationMatches(d) {
      let court = getAfter(/databases/$(database)/documents/establishments/$(d.establishmentId)/courts/$(d.courtId)).data;
      let venue = get(/databases/$(database)/documents/establishments/$(d.establishmentId)).data;
      let publicVenue = getAfter(/databases/$(database)/documents/catalog/$(d.establishmentId)).data;
      let publicCourt = getAfter(/databases/$(database)/documents/catalog/$(d.establishmentId)/courts/$(d.courtId)).data;
      return venue.status == 'published' && venue.bookingPolicy.enabled == true
        && venue.bookingEngine == 'direct'
        && publicVenue.status == 'published' && publicVenue.booking.enabled == true
        && publicVenue.booking.engine == 'direct' && publicVenue.booking.holdMinutes == 15
        && d.advanceCents == venue.bookingPolicy.advanceCents && d.advanceCents == publicVenue.advanceCents
        && d.establishmentName == publicVenue.name && d.courtName == publicCourt.name
        && d.paymentSnapshot == publicVenue.booking.payment
        && (d.paymentSnapshot.mode == 'demo' || (d.paymentSnapshot.recipient.size() >= 2 && d.paymentSnapshot.phone.size() >= 6))
        && court.status == 'active' && publicCourt.status == 'active'
        // La autorización usa la configuración canónica privada. Si una
        // proyección quedó desfasada, se rechaza la solicitud y se recarga.
        && court.get('maintenance', false) == false && court.get('runtime', null) == null
        && directScheduleAllows(d, court)
        && sessionAllowsRequest(d)
        && d.totalCents == (d.hour >= court.nightStartsAt ? court.nightPriceCents : court.dayPriceCents);
    }
    // Solo se consulta al CREAR. Los cambios no cancelan solicitudes existentes
    // ni impiden subir/revisar su comprobante o conservar el precio contratado.
    function directScheduleAllows(d, court) {
      let path = /databases/$(database)/documents/establishments/$(d.establishmentId)/settings/schedule;
      let closure = /databases/$(database)/documents/establishments/$(d.establishmentId)/closures/$(d.date);
      let schedule = existsAfter(path) ? getAfter(path).data : null;
      let weekday = (d.startsAt - duration.value(5, 'h')).dayOfWeek() % 7;
      return (!existsAfter(closure) || getAfter(closure).data.closed == false)
        && (schedule == null
          ? d.hour >= court.openHour && d.hour < court.closeHour
            && (court.get('openDays', []).size() == 0 || weekday in court.openDays)
          : d.hour >= schedule.openHour && d.hour < schedule.closeHour && weekday in schedule.days);
    }
    function directLockPath(d) {
      return /databases/$(database)/documents/direct_slots/$(d.establishmentId)/courts/$(d.courtId)/days/$(d.date)/hours/$(string(d.hour));
    }
    function directLimitPath(d) {
      return /databases/$(database)/documents/direct_limits/$(d.clientUid)/days/$(d.date);
    }
    function createsDirectHold(d, id) {
      let lock = getAfter(directLockPath(d)).data;
      let quota = getAfter(directLimitPath(d)).data;
      return lock.reservationId == id && lock.lockedAt == request.time && lock.status == 'held'
        && quota.lastRequestId == id && quota.updatedAt == request.time;
    }
    function validDirectLock(d) {
      return d.keys().hasAll(['reservationId','lockedAt','status'])
        && d.keys().hasOnly(['reservationId','lockedAt','status','reviewPending','serviceStatus','actualStartAt','actualEndAt'])
        && directId(d.reservationId) && d.lockedAt is timestamp
        && d.status in ['held','confirmed','released']
        && (!d.keys().hasAny(['reviewPending']) || (d.reviewPending is bool && (d.reviewPending == false || d.status == 'held')))
        && (!d.keys().hasAny(['serviceStatus','actualStartAt','actualEndAt'])
          || (d.status == 'confirmed' && d.keys().hasAll(['serviceStatus','actualStartAt']) && d.actualStartAt is timestamp
            && ((d.serviceStatus == 'running' && !d.keys().hasAny(['actualEndAt']))
              || (d.serviceStatus == 'completed' && d.actualEndAt is timestamp && d.actualEndAt == d.actualStartAt + duration.value(1, 'h')))));
    }
    function liveDirectHold(d, id) {
      let lock = get(directLockPath(d)).data;
      return d.createdAt + duration.value(15, 'm') > request.time && d.startsAt > request.time
        && lock.reservationId == id && lock.status == 'held'
        && lock.lockedAt == d.createdAt;
    }
    function validDirectProof(d, id) {
      return d.keys().hasAll(['reservationId','clientUid','establishmentId','contentType','imageData','sha256','createdAt'])
        && d.keys().hasOnly(['reservationId','clientUid','establishmentId','contentType','imageData','sha256','createdAt'])
        && directId(id) && d.reservationId == id
        && d.clientUid is string && d.clientUid.size() >= 1 && d.clientUid.size() <= 128
        && directId(d.establishmentId) && d.contentType == 'image/jpeg'
        && d.imageData is string && d.imageData.size() >= 32 && d.imageData.size() <= 700000
        && d.imageData.matches('^data:image/jpeg;base64,/9j/[A-Za-z0-9+/]+={0,2}$')
        && d.sha256 is string && d.sha256.matches('^[a-f0-9]{64}$')
        && d.createdAt is timestamp;
    }
    match /direct_requests/{id} {
      allow get: if authenticated() && (resource == null || owner(resource.data.clientUid) || activeMember(resource.data.establishmentId));
      allow list: if authenticated() && (owner(resource.data.clientUid) || activeMember(resource.data.establishmentId));
      allow create: if authenticated() && resource == null && directId(id)
        && owner(request.resource.data.clientUid)
        && request.resource.data.status == 'pending_payment' && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.createdAt == request.time
        && request.resource.data.startsAt > request.time
        && request.resource.data.startsAt <= request.time + duration.value(91, 'd')
        && createsDirectHold(request.resource.data, id)
        && directConfigurationMatches(request.resource.data)
        && validDirectRequest(request.resource.data);
      function submitsProof(d) {
        let proof = getAfter(/databases/$(database)/documents/direct_proofs/$(id)).data;
        let lock = getAfter(directLockPath(resource.data)).data;
        return owner(resource.data.clientUid) && resource.data.status == 'pending_payment'
          && liveDirectHold(resource.data, id)
          && d.diff(resource.data).affectedKeys().hasOnly(['status','paymentStatus','proofSubmittedAt'])
          && d.status == 'pending_verification' && d.paymentStatus == 'submitted'
          && d.proofSubmittedAt == request.time
          && lock.reservationId == id && lock.status == 'held' && lock.lockedAt == resource.data.createdAt && lock.reviewPending == true
          && proof.reservationId == id && proof.clientUid == resource.data.clientUid
          && proof.establishmentId == resource.data.establishmentId && proof.createdAt == request.time;
      }
      function reviewsProof(d) {
        let lock = getAfter(directLockPath(resource.data)).data;
        let incomePath = /databases/$(database)/documents/establishments/$(resource.data.establishmentId)/court_income/$(id);
        return activeMember(resource.data.establishmentId)
          && resource.data.status == 'pending_verification' && liveDirectHold(resource.data, id)
          && exists(/databases/$(database)/documents/direct_proofs/$(id))
          && d.diff(resource.data).affectedKeys().hasOnly(['status','paymentStatus','reviewedAt','reviewedBy','verifiedAdvanceCents'])
          && d.reviewedAt == request.time && d.reviewedBy == request.auth.uid
          && lock.reservationId == id && lock.lockedAt == resource.data.createdAt
          && lock.get('reviewPending', false) == false
          && ((d.status == 'confirmed' && lock.status == 'confirmed'
              && !exists(incomePath) && getAfter(incomePath).data == courtIncomeInitial(id, d))
            || (d.status == 'rejected' && lock.status == 'released'));
      }
      function recordsSession(d) {
        let path = sessionPath(resource.data.establishmentId, resource.data.courtId);
        let previous = exists(path) ? get(path).data : null;
        let current = getAfter(path).data;
        let slot = getAfter(directLockPath(resource.data)).data;
        let dayStart = resource.data.startsAt - duration.value(resource.data.hour, 'h');
        return managesSchedule(resource.data.establishmentId)
          && resource.data.status == 'confirmed' && resource.data.paymentStatus == 'verified'
          && d.diff(resource.data).affectedKeys().hasOnly(['serviceStatus','actualStartAt','actualEndAt'])
          && validDirectService(d)
          && current.updatedAt == request.time && current.updatedBy == request.auth.uid
          && nextRevision(current, previous)
          && slot.reservationId == id && slot.status == 'confirmed' && slot.lockedAt == resource.data.createdAt
          && slot.serviceStatus == d.serviceStatus && slot.actualStartAt == d.actualStartAt
          && ((resource.data.get('serviceStatus', '') == '' && d.serviceStatus == 'running'
              && d.actualStartAt == request.time && !d.keys().hasAny(['actualEndAt'])
              && resource.data.startsAt <= request.time && request.time >= dayStart && request.time < dayStart + duration.value(1, 'd')
              && sessionCanStart(previous)
              && current.activeReservationId == id && current.activeDate == resource.data.date && current.actualStartAt == request.time)
            || (resource.data.serviceStatus == 'running' && d.serviceStatus == 'completed'
              && d.actualStartAt == resource.data.actualStartAt
              && request.time >= resource.data.actualStartAt + duration.value(1, 'h')
              && d.actualEndAt == resource.data.actualStartAt + duration.value(1, 'h')
              && previous.activeReservationId == id && previous.actualStartAt == resource.data.actualStartAt
              && current.activeReservationId == null && current.lastEndedAt == d.actualEndAt
              && slot.actualEndAt == d.actualEndAt));
      }
      allow update: if authenticated() && resource != null
        // La rama operativa valida sus tres campos; el diff conserva todos los
        // campos históricos ya validados al crear/revisar, sin reevaluarlos.
        && (((submitsProof(request.resource.data) || reviewsProof(request.resource.data))
            && validDirectRequest(request.resource.data)) || recordsSession(request.resource.data));
      allow delete: if false;
    }
    match /direct_slots/{venue}/courts/{court}/days/{date}/hours/{hour} {
      // Disponibilidad sin identidad, importes ni contenido de comprobantes.
      // Incluye horas reales: un borrador solo lo consulta su administración.
      allow read: if authenticated()
        && exists(/databases/$(database)/documents/catalog/$(venue))
        && (get(/databases/$(database)/documents/catalog/$(venue)).data.status == 'published' || activeMember(venue));
      allow read: if superadmin() && exists(/databases/$(database)/documents/establishments/$(venue));
      function createsLock(d) {
        let booking = getAfter(/databases/$(database)/documents/direct_requests/$(d.reservationId)).data;
        return booking.clientUid == request.auth.uid && booking.createdAt == request.time
          && booking.establishmentId == venue && booking.courtId == court && booking.date == date && string(booking.hour) == hour
          && booking.status == 'pending_payment' && d.status == 'held' && d.lockedAt == request.time
          && d.get('reviewPending', false) == false;
      }
      function replacesLock() {
        let previous = get(/databases/$(database)/documents/direct_requests/$(resource.data.reservationId)).data;
        return (resource.data.status == 'released' && previous.status == 'rejected')
          || (resource.data.status == 'held' && resource.data.lockedAt + duration.value(15, 'm') <= request.time
            && previous.status in ['pending_payment','pending_verification']);
      }
      function reviewsLock(d) {
        let booking = getAfter(/databases/$(database)/documents/direct_requests/$(resource.data.reservationId)).data;
        return activeMember(venue) && resource.data.status == 'held'
          && d.diff(resource.data).affectedKeys().hasOnly(['status','reviewPending']) && d.get('reviewPending', false) == false
          && booking.establishmentId == venue && booking.courtId == court
          && booking.date == date && string(booking.hour) == hour
          && booking.reviewedBy == request.auth.uid && booking.reviewedAt == request.time
          && ((d.status == 'confirmed' && booking.status == 'confirmed' && booking.paymentStatus == 'verified')
            || (d.status == 'released' && booking.status == 'rejected'));
      }
      function submitsReviewMetadata(d) {
        let path = /databases/$(database)/documents/direct_requests/$(resource.data.reservationId);
        let previous = get(path).data;
        let current = getAfter(path).data;
        return resource.data.status == 'held' && resource.data.get('reviewPending', false) == false
          && d.diff(resource.data).affectedKeys().hasOnly(['reviewPending']) && d.reviewPending == true
          && previous.clientUid == request.auth.uid && previous.status == 'pending_payment'
          && previous.createdAt == resource.data.lockedAt && previous.createdAt + duration.value(15, 'm') > request.time
          && previous.startsAt > request.time && current.establishmentId == venue && current.courtId == court
          && current.date == date && string(current.hour) == hour
          && current.status == 'pending_verification' && current.paymentStatus == 'submitted'
          && current.proofSubmittedAt == request.time;
      }
      function recordsSessionLock(d) {
        let booking = getAfter(/databases/$(database)/documents/direct_requests/$(resource.data.reservationId)).data;
        let current = getAfter(sessionPath(venue, court)).data;
        return managesSchedule(venue) && resource.data.status == 'confirmed' && d.status == 'confirmed'
          && d.diff(resource.data).affectedKeys().hasOnly(['serviceStatus','actualStartAt','actualEndAt'])
          && booking.establishmentId == venue && booking.courtId == court && booking.date == date && string(booking.hour) == hour
          && d.serviceStatus == booking.serviceStatus && d.actualStartAt == booking.actualStartAt
          && current.updatedAt == request.time && current.updatedBy == request.auth.uid
          && ((d.serviceStatus == 'running' && d.actualStartAt == request.time && current.activeReservationId == d.reservationId)
            || (d.serviceStatus == 'completed' && request.time >= d.actualStartAt + duration.value(1, 'h')
              && d.actualEndAt == d.actualStartAt + duration.value(1, 'h') && d.actualEndAt == booking.actualEndAt && current.activeReservationId == null));
      }
      allow create: if authenticated() && resource == null && validDirectLock(request.resource.data) && createsLock(request.resource.data);
      allow update: if authenticated() && resource != null && validDirectLock(request.resource.data)
        && ((createsLock(request.resource.data) && replacesLock()) || submitsReviewMetadata(request.resource.data)
          || reviewsLock(request.resource.data) || recordsSessionLock(request.resource.data));
      allow delete: if false;
    }
    match /direct_proofs/{id} {
      allow get: if authenticated() && (resource == null || owner(resource.data.clientUid) || activeMember(resource.data.establishmentId));
      allow list: if false;
      function submitsOwnProof(d) {
        let booking = get(/databases/$(database)/documents/direct_requests/$(id)).data;
        let afterBooking = getAfter(/databases/$(database)/documents/direct_requests/$(id)).data;
        return owner(d.clientUid) && booking.clientUid == d.clientUid
          && booking.establishmentId == d.establishmentId && booking.status == 'pending_payment'
          && liveDirectHold(booking, id)
          && afterBooking.status == 'pending_verification' && afterBooking.paymentStatus == 'submitted'
          && afterBooking.proofSubmittedAt == request.time && d.createdAt == request.time;
      }
      allow create: if authenticated() && resource == null && validDirectProof(request.resource.data, id)
        && submitsOwnProof(request.resource.data);
      allow update, delete: if false;
    }
    function validDirectLimit(d) {
      return d.keys().hasAll(['count','lastRequestId','updatedAt'])
        && d.keys().hasOnly(['count','lastRequestId','updatedAt'])
        && d.count is int && d.count >= 1 && d.count <= 20
        && directId(d.lastRequestId) && d.updatedAt is timestamp;
    }
    match /direct_limits/{uid}/days/{date} {
      allow read: if owner(uid);
      function registersOwnRequest(d) {
        let path = /databases/$(database)/documents/direct_requests/$(d.lastRequestId);
        let booking = getAfter(path).data;
        return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && !exists(path) && booking.clientUid == uid && booking.date == date
          && booking.status == 'pending_payment' && booking.createdAt == request.time
          && d.updatedAt == request.time;
      }
      allow create: if owner(uid) && resource == null && validDirectLimit(request.resource.data)
        && request.resource.data.count == 1 && registersOwnRequest(request.resource.data);
      allow update: if owner(uid) && resource != null && validDirectLimit(request.resource.data)
        && request.resource.data.count == resource.data.count + 1
        && registersOwnRequest(request.resource.data);
      allow delete: if false;
    }
    match /establishment_invitations/{invitationId} {
      allow get: if superadmin() || ownInvitationEmail(resource.data);
      allow list: if request.query.limit != null && request.query.limit <= 100
        && (superadmin() || ownInvitationEmail(resource.data));
      allow create: if superadmin() && newVenueInCommit(invitationId)
        && initialInvitation(request.resource.data, invitationId,
          getAfter(/databases/$(database)/documents/establishments/$(invitationId)).data);
      allow update: if authenticated() && invitationId == resource.data.establishmentId
        && ownerChangeInCommit(resource.data.establishmentId)
        && acceptedInvitation(resource.data, request.resource.data);
      allow delete: if false;
    }
    match /audit_logs/{eventId} {
      allow get: if superadmin();
      allow list: if superadmin() && request.query.limit != null && request.query.limit <= 30;
      function validPlatformStatusAudit(d) {
        let path = /databases/$(database)/documents/establishments/$(d.establishmentId);
        let previous = get(path).data;
        let current = getAfter(path).data;
        return d.keys().hasAll(['action','establishmentId','actorUid','at','status','previousStatus','publicationStatus'])
          && d.keys().hasOnly(['action','establishmentId','actorUid','at','status','previousStatus','publicationStatus'])
          && directId(d.establishmentId) && exists(path)
          && current.platformStatusChangeId == eventId
          && linkedPlatformStatusChange(d.establishmentId, previous, current)
          && d == platformStatusEvent(d.establishmentId, previous, current);
      }
      function validLifecycleAudit(d) {
        let id = d.establishmentId;
        let path = /databases/$(database)/documents/establishments/$(id);
        let current = getAfter(path).data;
        return directId(id) && current.lifecycleChangeId == eventId && lifecycleMetadata(current)
          && ((d.action == 'establishment_created' && superadmin() && !exists(path)
              && initialVenue(current, id) && eventId == id
              && d == lifecycleEvent(id, 'establishment_created', 'approved', 'draft'))
            || (d.action == 'owner_invitation_accepted' && ownerChangeInCommit(id)
              && d == lifecycleEvent(id, 'owner_invitation_accepted', 'approved', 'draft'))
            || (d.action == 'business_published' && superadmin() && publishChangeInCommit(id)
              && validPublishedCourtsTail(getAfter(/databases/$(database)/documents/catalog/$(id)).data.courts, current.bookingPolicy.advanceCents)
              && d == lifecycleEvent(id, 'business_published', 'published', 'published')));
      }
      function validBusinessSettingAudit(d) {
        let id = d.establishmentId;
        let ref = d.referenceId;
        let rev = string(d.revision);
        let source = d.kind == 'closure'
          ? /databases/$(database)/documents/establishments/$(id)/closures/$(ref)/history/$(rev)
          : (d.kind == 'pricing'
            ? /databases/$(database)/documents/establishments/$(id)/courts/$(ref)/settings/pricing/history/$(rev)
            : /databases/$(database)/documents/establishments/$(id)/settings/$(d.kind)/history/$(rev));
        let event = getAfter(source).data;
        return d.keys().hasAll(['action','establishmentId','actorUid','at','kind','referenceId','revision'])
          && d.keys().hasOnly(['action','establishmentId','actorUid','at','kind','referenceId','revision'])
          && lifecycleUuid(eventId) && directId(id)
          && (d.kind == 'pricing' ? managesPricing(id) : activeMember(id))
          && d.actorUid == request.auth.uid && d.at == request.time && d.revision is int && d.revision >= 1 && d.revision <= 1000000000
          && d.kind in ['contact','payment','schedule','closure','pricing'] && d.referenceId is string && d.referenceId.size() <= 80
          && ((d.kind in ['contact','payment','schedule'] && ref == d.kind)
            || (d.kind == 'closure' && ref.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
            || (d.kind == 'pricing' && directId(ref)))
          && !exists(source) && event.establishmentId == id && event.kind == d.kind
          && event.revision == d.revision && event.actorUid == request.auth.uid && event.at == request.time;
      }
      allow create: if request.resource.data.action == 'establishment_status_changed'
        && superadmin() && validPlatformStatusAudit(request.resource.data);
      allow create: if request.resource.data.action in ['establishment_created','owner_invitation_accepted','business_published']
        && authenticated() && validLifecycleAudit(request.resource.data);
      allow create: if request.resource.data.action == 'business_setting_changed'
        && authenticated() && validBusinessSettingAudit(request.resource.data);
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
