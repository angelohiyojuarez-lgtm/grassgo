rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Modelo de esta entrega:
    // profiles/{uid}: uid string inmutable; displayName string 2..80;
    // phone string 0..20; createdAt timestamp inmutable; updatedAt timestamp.
    // platform_roles/{uid}: role superadmin, status active/suspended; servidor escribe.
    // users/{uid}/memberships/{id}: índice de asignaciones; servidor escribe.
    // establishments/{id}: tenant con status approved/published/suspended.
    // establishments/{id}/members/{uid}: role admin, status active/suspended;
    // autorización canónica, servidor escribe. No perfiles privados aquí.
    // establishments/{id}/courts/{id}: datos de cancha, servidor escribe por ahora.
    // catalog/{id}: presentación pública; solo proyecciones de configuración
    // autorizadas y servidor pueden actualizar campos expresamente permitidos.
    // catalog/{id}/courts/{id}: proyección pública del horario/tarifas de la cancha.
    // settings/schedule privado y campos horarios del catálogo: semana canónica.
    // closures/{fecha}: cierre solo para solicitudes nuevas; motivo/autor privados.
    // Cada cambio conserva una revisión inmutable y sincroniza su proyección.
    // settings/contact: phone string 0..20, description 0..1000, reference 0..300.
    // settings/payment: mode live, methods únicos Yape/Plin 1..2, recipient 2..100,
    // phone 8..20, qr payment-qrs/{local}/{id}; revisión, autor y reloj de servidor.
    // Ambos ajustes tienen history/{revision} privado, inmutable y atómico.
    // catalog/{id}/paymentQrs/{qrId}: JPEG dataURL 32..420000 caracteres,
    // width/height enteros 64..1600, sha256 hex64; cada versión es inmutable.
    // El QR se crea junto a sus datos de pago; nunca se copia al listado de locales.
    // courts/{court}/settings/pricing: importes enteros 1000..1000000 céntimos,
    // nightStartsAt 0..23, revisión/autor/reloj servidor e historial inmutable.
    // Cinco escrituras sincronizan canónico, cancha privada/pública, tarjeta e historia.
    // El índice courts[] guarda certificado pricingRevision + pricingConfirmed:true;
    // pricingUpdatedAt de servidor permanece fuera del array. Solo un precio
    // canónico validado puede certificar una entrada. El alta añade 1..20 canchas
    // con seis escrituras por cancha, sin mezclar bloqueos entre sus deportes.
    // courts/{court}/operations/current: un partido activo global por cancha;
    // activeReservationId/activeDate/actualStartAt null al finalizar, lastEndedAt
    // conserva inicio real+1h. Reloj servidor, revisión e historial privados;
    // proyección pública sin autor ni identidad del cliente. Vence tras 1h aunque
    // nadie abra el panel; el cierre se persiste después con ese límite exacto.
    // direct_requests/{id}: solicitud privada. Identidad, horario, importe y snapshot
    // de pago son inmutables; createdAt/proofSubmittedAt/reviewedAt usan request.time.
    // direct_slots/{local}/courts/{cancha}/days/{fecha}/hours/{hora}:
    // reservationId string, lockedAt timestamp inmutable, status held/confirmed/released.
    // direct_proofs/{id}: imagen JPEG dataURL <=700000 caracteres; propietario,
    // local, reservationId, contentType, sha256 y createdAt; un comprobante inmutable.
    // direct_limits/{uid}/days/{fecha}: count int 1..20, lastRequestId string,
    // updatedAt timestamp de servidor. Conserva el límite técnico del motor previo.
    // Los clientes nunca conceden roles ni verifican pagos. El administrador debe
    // declarar el ingreso real; una imagen por sí sola solo solicita revisión.
    // Superadmin directo: un cambio approved/suspended modifica solo estado,
    // enabled:false y platformStatusChangeId/UpdatedAt/UpdatedBy. Se replica en
    // catalog (draft/suspended si existe) con audit_logs/{UUID} nuevo e inmutable.
    // No publica, no activa reservas, no asigna roles ni modifica pagos/precios.
    // establishment_invitations/{UUID}: local/nombre, targetEmail normalizado
    // 5..254, pending/accepted, createdBy/At; acceptedBy/At solo al aceptar con
    // ese correo verificado, sin dueño anterior y con membresía e índice nuevos.
    // lifecycleChangeId UUID y lifecycleUpdatedAt/By enlazan altas/publicación
    // con audit_logs inmutable. El alta no inventa precios ni horarios.
    // audit_logs: estados/alta/aceptación/publicación y business_setting_changed
    // con kind/referenceId/revision, sin copiar before/after ni imágenes privadas.
    // direct_slots.reviewPending bool opcional: solo señala comprobante enviado;
    // no acredita dinero y se limpia al revisar. Adelanto por local, no universal.
    // kiosk_products/{UUID}: nombre 2..100, categoría 0..40, precio 1..1000000,
    // costo null o 0..1000000, stock 0..1000000, active, revisión/autor/reloj.
    // photo opcional: null o JPEG dataURL 32..180000 caracteres, sin URL externa.
    // Se conserva al vender/reponer y nunca se copia a snapshots del historial.
    // lastMovementId UUID nuevo enlaza cada alta/edición/reposición/venta con
    // kiosk_movements/{UUID} inmutable. Solo venta cobrada genera total/profit;
    // el costo desconocido conserva costos/ganancia null, nunca se supone cero.
    // court_income/{reservationId}: snapshot sin cliente ni comprobante, derivado
    // del adelanto confirmado; saldo completo una sola vez, con autor y reloj.

    function authenticated() { return request.auth != null; }
    function owner(uid) { return authenticated() && request.auth.uid == uid; }
    function superadmin() {
      return authenticated()
        && get(/databases/$(database)/documents/platform_roles/$(request.auth.uid)).data.role == 'superadmin'
        && get(/databases/$(database)/documents/platform_roles/$(request.auth.uid)).data.status == 'active';
    }
    function validPlatformStatusMetadata(d) {
      return d.keys().hasAll(['status','platformStatusChangeId','platformStatusUpdatedAt','platformStatusUpdatedBy'])
        && d.platformStatusChangeId is string
        && d.platformStatusChangeId.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$')
        && d.platformStatusUpdatedAt is timestamp && d.platformStatusUpdatedAt == request.time
        && d.platformStatusUpdatedBy is string && d.platformStatusUpdatedBy == request.auth.uid;
    }
    function validPlatformVenueStatus(previous, current) {
      return validPlatformStatusMetadata(current)
        && previous.status in ['draft','pending','approved','published','suspended']
        && current.status in ['approved','suspended'] && current.status != previous.status
        && current.diff(previous).affectedKeys().hasOnly(['status','bookingPolicy','platformStatusChangeId','platformStatusUpdatedAt','platformStatusUpdatedBy'])
        && current.bookingPolicy is map && current.bookingPolicy.enabled == false
        && current.bookingPolicy.diff(previous.get('bookingPolicy', {})).affectedKeys().hasOnly(['enabled']);
    }
    function platformStatusEvent(id, previous, current) {
      let published = exists(/databases/$(database)/documents/catalog/$(id));
      return {
        'action': 'establishment_status_changed', 'establishmentId': id,
        'actorUid': request.auth.uid, 'at': request.time,
        'status': current.status, 'previousStatus': previous.status,
        'publicationStatus': published ? (current.status == 'suspended' ? 'suspended' : 'draft') : 'missing'
      };
    }
    function validPlatformCatalogStatus(previous, current, venue) {
      return validPlatformStatusMetadata(current)
        && current.diff(previous).affectedKeys().hasOnly(['status','booking','platformStatusChangeId','platformStatusUpdatedAt','platformStatusUpdatedBy'])
        && current.status == (venue.status == 'suspended' ? 'suspended' : 'draft')
        && current.booking is map && current.booking.enabled == false
        && current.booking.diff(previous.get('booking', {})).affectedKeys().hasOnly(['enabled'])
        && current.platformStatusChangeId == venue.platformStatusChangeId
        && current.platformStatusUpdatedAt == venue.platformStatusUpdatedAt
        && current.platformStatusUpdatedBy == venue.platformStatusUpdatedBy;
    }
    function linkedPlatformStatusChange(id, previous, current) {
      let auditPath = /databases/$(database)/documents/audit_logs/$(current.platformStatusChangeId);
      let catalogPath = /databases/$(database)/documents/catalog/$(id);
      return validPlatformVenueStatus(previous, current)
        && !exists(auditPath)
        && getAfter(auditPath).data == platformStatusEvent(id, previous, current)
        && (!exists(catalogPath) || validPlatformCatalogStatus(get(catalogPath).data, getAfter(catalogPath).data, current));
    }
    // Alta conectada: un dueño acepta con su correo verificado; publicar exige
    // configuración real del piloto de una cancha. Los roles globales no se crean.
    function lifecycleUuid(id) {
      return id is string && id.matches('^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$');
    }
    function lifecycleMetadata(d) {
      return lifecycleUuid(d.lifecycleChangeId) && d.lifecycleUpdatedAt == request.time
        && d.lifecycleUpdatedBy == request.auth.uid;
    }
    function lifecycleEvent(id, action, status, publication) {
      return {'action': action, 'establishmentId': id, 'actorUid': request.auth.uid,
        'at': request.time, 'status': status, 'publicationStatus': publication};
    }
    function lifecycleAuditMatches(id, d, action, status, publication) {
      return getAfter(/databases/$(database)/documents/audit_logs/$(d.lifecycleChangeId)).data
        == lifecycleEvent(id, action, status, publication);
    }
    function initialVenue(d, id) {
      return d.keys().hasAll(['name','location','status','bookingEngine','bookingPolicy','ownerInvitationId','createdBy','createdAt','lifecycleChangeId','lifecycleUpdatedAt','lifecycleUpdatedBy'])
        && d.keys().hasOnly(['name','location','status','bookingEngine','bookingPolicy','ownerInvitationId','createdBy','createdAt','lifecycleChangeId','lifecycleUpdatedAt','lifecycleUpdatedBy'])
        && lifecycleUuid(id) && lifecycleMetadata(d) && d.lifecycleChangeId == id && d.ownerInvitationId == id
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.location is string && d.location.size() >= 2 && d.location.size() <= 200
        && d.status == 'approved' && d.bookingEngine == 'direct'
        && d.bookingPolicy.keys().hasAll(['enabled','advanceCents','holdMinutes'])
        && d.bookingPolicy.keys().hasOnly(['enabled','advanceCents','holdMinutes'])
        && d.bookingPolicy.enabled == false && d.bookingPolicy.holdMinutes == 15
        && d.bookingPolicy.advanceCents is int && d.bookingPolicy.advanceCents >= 1 && d.bookingPolicy.advanceCents <= 1000000
        && d.createdBy == request.auth.uid && d.createdAt == request.time;
    }
    function initialCourt(d) {
      return d.keys().hasAll(['name','sport','surface','images','dayPriceCents','nightPriceCents','nightStartsAt','status','maintenance','runtime'])
        && d.keys().hasOnly(['name','sport','surface','images','dayPriceCents','nightPriceCents','nightStartsAt','status','maintenance','runtime'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 100
        && d.sport is string && d.sport.size() >= 2 && d.sport.size() <= 50
        && d.surface is string && d.surface.size() >= 2 && d.surface.size() <= 80
        && d.images is list && d.images.size() == 0
        && d.dayPriceCents == null && d.nightPriceCents == null && d.nightStartsAt == null
        && d.status == 'active' && d.maintenance == false && d.runtime == null;
    }
    function initialCourtCard(c) {
      return {'id':'principal','name':c.name,'sport':c.sport,'surface':c.surface,'images':[],
        'dayPriceCents':null,'nightPriceCents':null,'nightStartsAt':null};
    }
    function initialCatalog(p, v) {
      return p.keys().hasAll(['name','location','status','description','reference','district','phone','images','courts','advanceCents','booking','lifecycleChangeId','lifecycleUpdatedAt','lifecycleUpdatedBy'])
        && p.keys().hasOnly(['name','location','status','description','reference','district','phone','images','courts','advanceCents','booking','lifecycleChangeId','lifecycleUpdatedAt','lifecycleUpdatedBy'])
        && lifecycleMetadata(p) && p.lifecycleChangeId == v.lifecycleChangeId
        && p.name == v.name && p.location == v.location && p.status == 'draft'
        && p.description == '' && p.reference == '' && p.district == '' && p.phone == ''
        && p.images == [] && p.courts == [] && p.advanceCents == v.bookingPolicy.advanceCents
        && p.booking == {'engine':'direct','enabled':false,'holdMinutes':15};
    }
    function ownInvitationEmail(d) {
      return authenticated() && request.auth.token.get('email', '') is string
        && d.targetEmail == request.auth.token.get('email', '').lower();
    }
    function initialInvitation(d, id, v) {
      return d.keys().hasAll(['establishmentId','establishmentName','targetEmail','status','createdBy','createdAt'])
        && d.keys().hasOnly(['establishmentId','establishmentName','targetEmail','status','createdBy','createdAt'])
        && d.establishmentId == id && d.establishmentName == v.name
        && d.targetEmail is string && d.targetEmail.size() >= 5 && d.targetEmail.size() <= 254
        && d.targetEmail == d.targetEmail.lower() && d.targetEmail.matches('^[^ @]+@[^ @]+[.][^ @]+$')
        && d.status == 'pending' && d.createdBy == request.auth.uid && d.createdAt == request.time;
    }
    function newVenueInCommit(id) {
      let path = /databases/$(database)/documents/establishments/$(id);
      return !exists(path) && initialVenue(getAfter(path).data, id);
    }
    function createsConnectedVenue(id, d) {
      return initialVenue(d, id)
        && initialCatalog(getAfter(/databases/$(database)/documents/catalog/$(id)).data, d)
        && initialInvitation(getAfter(/databases/$(database)/documents/establishment_invitations/$(id)).data, id, d)
        && lifecycleAuditMatches(id, d, 'establishment_created', 'approved', 'draft');
    }
    function acceptsOwnerChange(id, previous, current) {
      return !previous.keys().hasAny(['managedAdminUid']) && previous.status == 'approved'
        && previous.bookingEngine == 'direct' && previous.bookingPolicy.enabled == false
        && current.diff(previous).affectedKeys().hasOnly(['managedAdminUid','lifecycleChangeId','lifecycleUpdatedAt','lifecycleUpdatedBy'])
        && current.managedAdminUid == request.auth.uid && lifecycleMetadata(current)
        && current.lifecycleChangeId != previous.get('lifecycleChangeId', '');
    }
    function ownerChangeInCommit(id) {
      let path = /databases/$(database)/documents/establishments/$(id);
      return exists(path) && request.auth.token.get('email_verified', false) == true
        && acceptsOwnerChange(id, get(path).data, getAfter(path).data);
    }
    function acceptedInvitation(previous, current) {
      return ownInvitationEmail(previous) && request.auth.token.get('email_verified', false) == true
        && previous.status == 'pending' && current.status == 'accepted'
        && current.diff(previous).affectedKeys().hasOnly(['status','acceptedAt','acceptedBy'])
        && current.acceptedBy == request.auth.uid && current.acceptedAt == request.time;
    }
    function acceptsConnectedOwner(id, previous, current) {
      let invitation = /databases/$(database)/documents/establishment_invitations/$(previous.ownerInvitationId);
      let member = /databases/$(database)/documents/establishments/$(id)/members/$(request.auth.uid);
      let index = /databases/$(database)/documents/users/$(request.auth.uid)/memberships/$(id);
      let p = get(/databases/$(database)/documents/catalog/$(id)).data;
      return acceptsOwnerChange(id, previous, current) && request.auth.token.get('email_verified', false) == true
        && previous.ownerInvitationId == id && get(invitation).data.establishmentId == id
        && get(invitation).data.establishmentName == previous.name
        && acceptedInvitation(get(invitation).data, getAfter(invitation).data)
        && p.status == 'draft' && p.booking.enabled == false
        && !exists(member) && getAfter(member).data == {'role':'admin','status':'active'}
        && !exists(index) && getAfter(index).data == {'name': previous.name,'role':'admin','status':'active'}
        && lifecycleAuditMatches(id, current, 'owner_invitation_accepted', 'approved', 'draft');
    }
    function publishChange(previous, current) {
      return previous.status in ['approved','published'] && previous.bookingEngine == 'direct'
        && previous.bookingPolicy.enabled == false && current.status == 'published'
        && current.diff(previous).affectedKeys().hasOnly(['status','bookingPolicy','lifecycleChangeId','lifecycleUpdatedAt','lifecycleUpdatedBy'])
        && lifecycleMetadata(current) && current.lifecycleChangeId != previous.get('lifecycleChangeId','')
        && current.bookingPolicy.enabled == true && current.bookingPolicy.holdMinutes == 15
        && previous.bookingPolicy.get('holdMinutes', 15) == 15
        && current.bookingPolicy.diff(previous.bookingPolicy).affectedKeys().hasOnly(['enabled','holdMinutes','advanceCents']);
    }
    function publishChangeInCommit(id) {
      let path = /databases/$(database)/documents/establishments/$(id);
      let previous = get(path).data;
      let current = getAfter(path).data;
      // Solo la rama privada de publicación puede pasar enabled false -> true.
      // Las tres escrituras coordinadas validan dueño, horarios, certificados,
      // pago y QR; ninguna publicación puede omitir uno de esos controles.
      return previous.bookingPolicy.enabled == false && current.bookingPolicy.enabled == true
        && current.status == 'published' && current.lifecycleChangeId != previous.get('lifecycleChangeId', '');
    }
    function readyWeekly(w, p, id) {
      return w.establishmentId == id && validWeekdays(w.days) && w.days.size() >= 1
        && w.openHour is int && w.openHour >= 0 && w.openHour <= 23
        && w.closeHour is int && w.closeHour > w.openHour && w.closeHour <= 24
        && w.revision is int && w.revision >= 1 && scheduleProjectionMatches(w, p);
    }
    function readyPayment(w, p, id) {
      return w.establishmentId == id && w.mode == 'live' && w.revision is int && w.revision >= 1
        && w.qr is string && w.qr.size() <= 175 && w.qr.matches('^payment-qrs/' + id + '/[A-Za-z0-9-]{1,80}$')
        && w.methods is list && w.methods.size() >= 1 && w.methods.size() <= 2
        && w.methods.hasOnly(['Yape','Plin']) && w.methods.toSet().size() == w.methods.size()
        && w.recipient is string && w.recipient.size() >= 2 && w.recipient.size() <= 100
        && w.phone is string && w.phone.size() >= 8 && w.phone.size() <= 20 && w.phone.matches('^[+]?[0-9][0-9 ()-]{7,19}$')
        && paymentProjectionMatches(w, p) && paymentHasQr(w, id);
    }
    function validPublishedCertificate(c, advance) {
      // El alta y cada cambio de precio certifican este índice atómicamente con
      // el canónico tipado y acotado. No se repiten sus validadores de tipos:
      // una entrada sin esa procedencia no puede obtener pricingConfirmed.
      return c.pricingConfirmed == true && c.pricingRevision >= 1
        && c.dayPriceCents >= advance && c.nightPriceCents >= advance;
    }
    function validPublishedCourts(c, advance) {
      let count = c.size();
      return c is list && count >= 1 && count <= 20
        && validPublishedCertificate(c[0], advance)
        && (count < 2 || validPublishedCertificate(c[1], advance))
        && (count < 3 || validPublishedCertificate(c[2], advance))
        && (count < 4 || validPublishedCertificate(c[3], advance))
        && (count < 5 || validPublishedCertificate(c[4], advance))
        && (count < 6 || validPublishedCertificate(c[5], advance))
        && (count < 7 || validPublishedCertificate(c[6], advance))
        && (count < 8 || validPublishedCertificate(c[7], advance))
        && (count < 9 || validPublishedCertificate(c[8], advance))
        && (count < 10 || validPublishedCertificate(c[9], advance));
    }
    function validPublishedCourtsTail(c, advance) {
      let count = c.size();
      // La escritura privada valida 1..10; la auditoría nueva valida 11..20.
      // Ambas escrituras son obligatorias y observan el mismo catálogo inmutable.
      return c is list && count >= 1 && count <= 20
        && (count < 11 || validPublishedCertificate(c[10], advance))
        && (count < 12 || validPublishedCertificate(c[11], advance))
        && (count < 13 || validPublishedCertificate(c[12], advance))
        && (count < 14 || validPublishedCertificate(c[13], advance))
        && (count < 15 || validPublishedCertificate(c[14], advance))
        && (count < 16 || validPublishedCertificate(c[15], advance))
        && (count < 17 || validPublishedCertificate(c[16], advance))
        && (count < 18 || validPublishedCertificate(c[17], advance))
        && (count < 19 || validPublishedCertificate(c[18], advance))
        && (count < 20 || validPublishedCertificate(c[19], advance));
    }
    function publishedCatalogChange(previous, current, venue) {
      return current.diff(previous).affectedKeys().hasOnly(['status','booking','lifecycleChangeId','lifecycleUpdatedAt','lifecycleUpdatedBy'])
        && lifecycleMetadata(current) && current.lifecycleChangeId == venue.lifecycleChangeId
        && current.lifecycleChangeId != previous.get('lifecycleChangeId', '')
        && current.status == 'published' && current.booking.enabled == true && current.booking.engine == 'direct'
        && current.booking.holdMinutes == 15
        && previous.get('booking', {}).get('holdMinutes', 15) == 15
        && current.booking.diff(previous.get('booking', {})).affectedKeys().hasOnly(['enabled','engine','holdMinutes']);
    }
    function publishesConnectedVenue(id, previous, current) {
      let path = /databases/$(database)/documents/catalog/$(id);
      let p = getAfter(path).data;
      let member = get(/databases/$(database)/documents/establishments/$(id)/members/$(current.managedAdminUid)).data;
      // El UUID nuevo obliga a escribir el catálogo. Su regla valida los datos
      // de pago y el QR; dividir los controles evita el límite de expresiones.
      return publishChange(previous, current)
        && p.lifecycleChangeId == current.lifecycleChangeId && p.lifecycleChangeId != get(path).data.get('lifecycleChangeId', '')
        && p.lifecycleUpdatedAt == request.time && p.status == 'published' && p.booking.enabled == true
        && member.role == 'admin' && member.status == 'active'
        && current.bookingPolicy.holdMinutes == 15 && p.advanceCents == current.bookingPolicy.advanceCents
        // Solo se completa un adelanto privado ausente desde el importe público
        // ya guardado. El catálogo conserva ese importe durante la publicación.
        && current.bookingPolicy.advanceCents == previous.bookingPolicy.get('advanceCents', p.advanceCents)
        && current.bookingPolicy.advanceCents is int && current.bookingPolicy.advanceCents >= 1 && current.bookingPolicy.advanceCents <= 1000000
        && validPublishedCourts(p.courts, current.bookingPolicy.advanceCents)
        && readyWeekly(get(/databases/$(database)/documents/establishments/$(id)/settings/schedule).data, p, id)
        && !exists(/databases/$(database)/documents/audit_logs/$(current.lifecycleChangeId))
        && lifecycleAuditMatches(id, current, 'business_published', 'published', 'published');
    }
    function activeMember(id) {
      return authenticated()
        && exists(/databases/$(database)/documents/establishments/$(id))
        && get(/databases/$(database)/documents/establishments/$(id)).data.status in ['approved', 'published']
        && get(/databases/$(database)/documents/establishments/$(id)/members/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/establishments/$(id)/members/$(request.auth.uid)).data.status == 'active';
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'phone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'phone', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == uid && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 80
        && data.displayName.matches('.*[^ ].*')
        && data.phone is string && data.phone.size() <= 20 && data.phone.matches('^[+0-9 ()-]{0,20}$')
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function managesSchedule(id) {
      return activeMember(id)
        && get(/databases/$(database)/documents/establishments/$(id)).data.bookingEngine == 'direct';
    }
    function managesPricing(id) {
      let venue = get(/databases/$(database)/documents/establishments/$(id)).data;
      return authenticated() && (activeMember(id) || superadmin()) && venue.bookingEngine == 'direct'
        && venue.status in ['draft','pending','approved','published','suspended'];
    }
    // El quiosco tiene permisos propios: no se amplían los de horarios o pagos.
    function readsKiosk(id) {
      let venue = get(/databases/$(database)/documents/establishments/$(id)).data;
      return authenticated() && venue.bookingEngine == 'direct' && (activeMember(id) || superadmin());
    }
    function managesKiosk(id) {
      let venue = get(/databases/$(database)/documents/establishments/$(id)).data;
      return readsKiosk(id) && venue.status in ['approved','published'];
    }
    function validKioskPhoto(photo) {
      return photo == null || (photo is string && photo.size() >= 32 && photo.size() <= 180000
        && photo.matches('^data:image/jpeg;base64,/9j/[A-Za-z0-9+/]+={0,2}$'));
    }
    function validKioskProduct(d) {
      return d.keys().hasAll(['name','category','priceCents','costCents','stock','active','revision','createdAt','createdBy','updatedAt','updatedBy','lastMovementId'])
        && d.keys().hasOnly(['name','category','priceCents','costCents','stock','active','revision','createdAt','createdBy','updatedAt','updatedBy','lastMovementId','photo'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 100 && d.name.matches('.*[^ ].*')
        && d.category is string && d.category.size() <= 40
        && d.priceCents is int && d.priceCents >= 1 && d.priceCents <= 1000000
