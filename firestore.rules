    function sessionHistory(id, courtId, previous, current) {
      return {'establishmentId': id, 'courtId': courtId, 'kind': 'session', 'revision': current.revision,
        'actorUid': request.auth.uid, 'at': request.time,
        'action': current.activeReservationId == null ? 'finish' : 'start',
        'reservationId': sessionRequestId(previous, current), 'before': previous, 'after': current};
    }
    function validSessionTransition(previous, current, id, courtId) {
      let reservationId = sessionRequestId(previous, current);
      let beforeBooking = get(/databases/$(database)/documents/direct_requests/$(reservationId)).data;
      let afterBooking = getAfter(/databases/$(database)/documents/direct_requests/$(reservationId)).data;
      let start = current.activeReservationId != null;
      return beforeBooking.establishmentId == id && beforeBooking.courtId == courtId
        && beforeBooking.status == 'confirmed' && beforeBooking.paymentStatus == 'verified'
        && afterBooking.establishmentId == id && afterBooking.courtId == courtId
        && (start
          ? sessionCanStart(previous)
            && get(/databases/$(database)/documents/establishments/$(id)/courts/$(courtId)).data.status == 'active'
            && (previous == null || previous.lastEndedAt == null || request.time >= previous.lastEndedAt)
            && beforeBooking.get('serviceStatus', '') == '' && !beforeBooking.keys().hasAny(['actualStartAt','actualEndAt'])
            && current.activeDate == beforeBooking.date && current.actualStartAt == request.time
            && current.lastEndedAt == sessionLastEnd(previous)
            && afterBooking.serviceStatus == 'running' && afterBooking.actualStartAt == request.time
          : previous != null && previous.activeReservationId != null
            && beforeBooking.serviceStatus == 'running' && beforeBooking.actualStartAt == previous.actualStartAt
            && request.time >= beforeBooking.actualStartAt + duration.value(1, 'h')
            && current.lastEndedAt == beforeBooking.actualStartAt + duration.value(1, 'h') && afterBooking.serviceStatus == 'completed'
            && afterBooking.actualStartAt == beforeBooking.actualStartAt
            && afterBooking.actualEndAt == beforeBooking.actualStartAt + duration.value(1, 'h'));
    }
    function sessionAllowsRequest(d) {
      let path = sessionPath(d.establishmentId, d.courtId);
